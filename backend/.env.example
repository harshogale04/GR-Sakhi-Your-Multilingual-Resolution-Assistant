# ==============================================================================
# MAHA-GR Backend Environment Configuration
# ==============================================================================

# Core Application Settings
PROJECT_NAME="MAHA-GR"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Supabase Configuration
# Existing Supabase PostgreSQL Project & Storage Bucket
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"
SUPABASE_STORAGE_BUCKET="government-resolutions"

# Pinecone Vector Database Configuration
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="maha-gr-index"

# Google Gemini AI Configuration
# Uses Google Gemini Flash & gemini-embedding-001
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-001"

# OCR Configuration (Optional Windows fallback path)
TESSERACT_CMD=""
